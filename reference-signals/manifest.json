  {
   "file": "stereo_out_of_phase.wav",
   "description": "440 Hz tone with the right channel polarity-inverted (correlation -1). Sounds wide on headphones but cancels to silence in mono: the classic phase-problem test.",
   "format": {
    "format": "WAV",
    "subtype": "PCM_24",
    "sample_rate": 48000,
    "channels": 2,
    "duration_s": 4.0
   },
   "ground_truth": {
    "correlation": -1.0,
    "mono_sum": "silence"
   },
   "verification": [
    {
     "measure": "audio_analyze:stereo.correlation",
     "expect": -1.0,
     "tol": 0.001,
     "measured": -1.0,
     "pass": true
    },
    {
     "measure": "audio_analyze:issues",
     "contains": "out of phase",
     "measured": [
      {
       "severity": "warning",
       "message": "True peak -1.0 dBTP; above -1 dBTP risks clipping after MP3/AAC encoding."
      },
      {
       "severity": "warning",
       "message": "Extremely loud: -1.69 LUFS; likely heavily limited, and streaming services will turn it down."
      },
      {
       "severity": "error",
       "message": "The audio is silent (nothing above -60.0 dBFS)."
      },
      {
       "severity": "error",
       "message": "Channels are out of phase (correlation -1.0); summed to mono the level changes by -168.81 dB, so it will thin out or vanish on mono speakers."
      }
     ],
     "pass": true
    }
   ],
   "recipe": [
    {
     "tool": "audio_synthesize",
     "args": {
