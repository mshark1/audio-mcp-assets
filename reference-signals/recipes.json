{
  "pack": {
    "name": "audio-mcp reference signals",
    "version": "1.0.0",
    "description": "Test and calibration audio with known ground truth, for checking audio software, meters and AI audio perception. Every file is synthesized from scratch with audio-mcp and verified against its intended values.",
    "made_with": "https://github.com/mshark1/audio-mcp"
  },
  "assets": [
    {
      "file": "tone_997Hz_-20dBFS_mono.wav",
      "description": "Steady 997 Hz sine (the EBU reference frequency, chosen to avoid aligning with sample rates), sample peak -20 dBFS, 10 s.",
      "ground_truth": {
        "frequency_hz": 997,
        "peak_dbfs": -20.0,
        "rms_dbfs": -23.01,
        "duration_s": 10
      },
      "steps": [
        {
          "tool": "audio_synthesize",
          "args": {
            "spec": {
              "sample_rate": 48000,
              "normalize_peak_db": -20,
              "layers": [
                {
                  "wave": "sine",
                  "freq": 997,
                  "duration": 10
                }
              ]
            },
            "output": "{out}",
            "overwrite": true
          }
        }
      ],
      "checks": [
        {
          "tool": "audio_analyze",
          "field": "levels.peak_dbfs",
          "expect": -20.0,
          "tol": 0.01
        },
        {
          "tool": "audio_analyze",
          "field": "levels.rms_dbfs",
          "expect": -23.01,
          "tol": 0.02
        },
        {
          "tool": "audio_analyze",
          "field": "pitch.median.hz",
          "expect": 997,
          "tol": 1.5
        },
        {
          "tool": "audio_analyze",
          "field": "levels.clipped_samples",
          "expect": 0
        }
      ]
    },
    {
      "file": "tone_997Hz_-23LUFS_stereo.wav",
      "description": "997 Hz sine in both channels, normalized to exactly -23 LUFS integrated (EBU R128 broadcast target). Use it to check a loudness meter.",
      "ground_truth": {
        "frequency_hz": 997,
        "lufs_integrated": -23.0,
        "channels": "identical"
      },
      "steps": [
        {
          "tool": "audio_synthesize",
          "args": {
            "spec": {
              "sample_rate": 48000,
              "stereo": true,
              "layers": [
                {
                  "wave": "sine",
                  "freq": 997,
                  "duration": 10
                }
              ]
            },
            "output": "{tmp}/t997s.wav",
            "overwrite": true
          }
        },
        {
          "tool": "audio_process",
          "args": {
            "path": "{tmp}/t997s.wav",
            "operations": [
              {
                "op": "normalize_lufs",
                "lufs": -23
              }
            ],
            "output": "{out}",
            "overwrite": true
          }
        }
      ],
      "checks": [
        {
          "tool": "audio_analyze",
          "field": "levels.lufs_integrated",
          "expect": -23.0,
          "tol": 0.05
        },
        {
          "tool": "audio_analyze",
          "field": "stereo.width",
          "expect": "mono (identical channels)"
        }
      ]
    },
    {
