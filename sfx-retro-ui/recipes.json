 },
 "assets": [
  {
   "file": "ui_click.wav",
   "description": "Crisp, very short interface click.",
   "steps": [
    {
     "tool": "audio_synthesize",
     "args": {
      "spec": {
       "sample_rate": 48000,
       "seed": 835,
       "layers": [
        {
         "wave": "noise",
         "duration": 0.012,
         "highpass": 2500,
         "envelope": {
          "attack": 0.0005,
          "release": 0.011
         }
        },
        {
         "wave": "sine",
         "freq": 2200,
         "duration": 0.012,
         "gain_db": -8,
         "envelope": {
          "attack": 0.0005,
          "release": 0.011
         }
        }
       ]
      },
      "output": "{tmp}/ui_click.wav",
      "overwrite": true
     }
    },
    {
     "tool": "audio_process",
     "args": {
      "path": "{tmp}/ui_click.wav",
      "operations": [
       {
        "op": "fade_out",
        "seconds": 0.004
       },
       {
        "op": "normalize_lufs",
        "lufs": -16,
        "measure": "momentary_max",
        "ceiling_db": -1.0
       }
      ],
      "output": "{out}",
      "overwrite": true
     }
    }
   ],
   "checks": [
    {
     "tool": "audio_analyze",
     "field": "levels.clipped_samples",
     "expect": 0
    },
    {
     "tool": "audio_analyze",
     "field": "levels.true_peak_dbtp",
     "max": -1.0
    },
    {
     "tool": "audio_analyze",
     "field": "levels.lufs_momentary_max",
     "max": -15.9
    },
    {
     "tool": "audio_analyze",
     "field": "silence.leading_s",
     "max": 0.005
    },
    {
     "tool": "audio_analyze",
     "field": "edges.end_amplitude",
     "max": 0.01
    }
   ]
  },
